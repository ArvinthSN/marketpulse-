# Local development database (no PostgreSQL server required).
# Docker Compose overrides DATABASE_URL to use its PostgreSQL service.
DATABASE_URL=sqlite:///./marketpulse.db

API_HOST=0.0.0.0
API_PORT=8000
ADMIN_API_KEY=change-me
YAHOO_TIMEOUT_SECONDS=20
YAHOO_RETRIES=3
YAHOO_RATE_LIMIT_DELAY_SECONDS=1.0
REDIS_URL=redis://localhost:6379/0

# Keep real credentials in your untracked local .env file only.
EODHD_API_KEY=
TWELVE_DATA_API_KEY=
MASSIVE_API_KEY=

# Set to eodhd after adding a valid key. Fallbacks are attempted in order.
MARKET_DATA_PROVIDER=none
MARKET_DATA_FALLBACK_PROVIDERS=twelvedata,massive
MARKET_DATA_PROVIDER_TIMEOUT_SECONDS=15
MARKET_DATA_PROVIDER_RETRIES=2

MARKET_DATA_API_KEY=
MARKET_DATA_API_SECRET=
MARKET_DATA_MODE=snapshot
MARKET_DATA_DELAY_SECONDS=0
MARKET_DATA_CACHE_TTL=300
MARKET_DATA_MAX_SUBSCRIPTIONS=100
MARKET_DATA_MAX_CONNECTIONS=1000
MARKET_DATA_PERSISTENCE_MODE=latest-state-only
